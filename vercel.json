{
  "headers": [
    {
      "source": "/download/latest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=60"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/products/quickshottransfer",
      "destination": "/products/inlet",
      "permanent": true
    },
    {
      "source": "/download/Inlet-Setup-0.1.5.exe",
      "destination": "https://github.com/timocore/pairlinx-website/releases/download/v0.1.5/Inlet-Setup-0.1.5.exe",
      "permanent": false
    },
    {
      "source": "/download/Inlet-Setup-0.1.6.exe",
      "destination": "https://github.com/timocore/pairlinx-website/releases/download/v0.1.6/Inlet-Setup-0.1.6.exe",
      "permanent": false
    },
    {
      "source": "/download/Inlet-Setup-0.1.7.exe",
      "destination": "https://github.com/timocore/pairlinx-website/releases/download/v0.1.7/Inlet-Setup-0.1.7.exe",
      "permanent": false
    },
    {
      "source": "/download/Inlet-Setup-0.1.8.exe",
      "destination": "https://github.com/timocore/pairlinx-website/releases/download/v0.1.8/Inlet-Setup-0.1.8.exe",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
